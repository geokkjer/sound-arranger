#!/usr/bin/env bash
# Attribute model commits automatically (paired with scripts/agent-commit).
#
# `scripts/agent-commit` exports `DSH_AGENT_TRAILER` for the model and harness it is
# committing as; this hook appends it verbatim whenever the message carries no
# `Assisted-by:` trailer yet. Everything else is left exactly as written: the hook
# discloses, it does not police.
#
# A **retired** identity is deliberately left unattributed rather than stamped. The hook used
# to auto-append a trailer for `DeepSeek V4 Flash`; that model is retired, so a new commit
# carrying its name is unattributable, and an absent trailer states that honestly where a
# trailer naming a model that no longer exists would assert something false. Such a commit is
# warned about, so a caller who meant to name a model notices, and then left anonymous.
#
# The hook receives the message file as $1; editing that file is the supported way to
# amend the message before the commit object is created.
set -euo pipefail

msg_file="${1:?commit-msg hook needs the message file path}"
author="${GIT_AUTHOR_NAME:-}"
author_email="${GIT_AUTHOR_EMAIL:-}"

# Identity names whose model no longer exists. Anything here is treated as anonymous.
retired='DeepSeek V4 Flash'

trailer="${DSH_AGENT_TRAILER:-}"
if [[ -z "$trailer" ]]; then
  if [[ "$author" == "$retired" ]]; then
    printf 'commit-msg: "%s" is a retired identity; leaving this commit unattributed (anonymous). Use scripts/agent-commit --model/--harness to name the model that actually ran.\n' "$retired" >&2
    exit 0
  fi
  # A model identity set by hand, with no generated disclosure. Say so rather than let it
  # pass silently — an unattributed model commit is what this convention exists to prevent —
  # but do not block: a deliberate hand-authored commit under a model name is the human's call.
  if [[ "$author_email" == *"@geokkjer.eu" && "${author_email%%@*}" != "geir" ]]; then
    printf 'commit-msg: %s <%s> looks like a model identity with no Assisted-by trailer; use scripts/agent-commit (--model/--harness) so the disclosure is generated rather than remembered.\n' "$author" "$author_email" >&2
  fi
  exit 0
fi

# Already attributed? Leave it alone (idempotent across --amend and re-runs).
if grep -qE '^Assisted-by:' "$msg_file"; then
  exit 0
fi

# Trim trailing blank lines, then append exactly one blank line + the trailer, so the
# message always ends in a clean trailer block.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
awk 'NF { last = NR } { line[NR] = $0 } END { for (i = 1; i <= last; i++) print line[i] }' "$msg_file" > "$tmp"
printf '\n%s\n' "$trailer" >> "$tmp"
mv "$tmp" "$msg_file"
