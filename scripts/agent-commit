#!/usr/bin/env bash
# Commit as the model, not the human.
#
# Git cannot tell *who* is committing from repository config: `includeIf` keys on
# path/branch/remote, not on the actor, and both the human and the agent commit in this
# checkout. So the actor sets the identity, and this wrapper is that for agent commits:
#
#   author    = <model> <model-slug@geokkjer.eu>   (--model / $DSH_AGENT_MODEL, REQUIRED)
#   committer = the human's configured identity    (deliberately untouched)
#   trailer   = Assisted-by: <model> · <harness>   (--harness / $DSH_AGENT_HARNESS)
#
# The model is required, not defaulted. A default can only guess which model is running,
# and this wrapper exists because that guess was wrong once. `DeepSeek V4 Flash` — the old
# default — is retired, so emitting it would attribute new work to a model that no longer
# exists: a false claim is worse than a missing one. The harness still defaults to this
# repository's own, and the wrapper echoes both so a wrong label is visible at commit time
# rather than discovered in the log afterwards.
#
# The email is derived, not configured: the model name lowercased with each run of
# non-alphanumerics collapsed to one dash ("DeepSeek V4 Flash" -> deepseek-v4-flash), a
# subaddress of the human's own domain so the identity stays non-human and greppable.
#
# Usage:
#   scripts/agent-commit --model "DeepSeek-V4.1-Flash" -m "…"
#   scripts/agent-commit --model "Space Bunny" --harness "OpenCode" -m "…"
#   export DSH_AGENT_MODEL=… DSH_AGENT_HARNESS=…; scripts/agent-commit -F -
# Everything this wrapper does not recognise is passed to `git commit` verbatim.
set -euo pipefail

model="${DSH_AGENT_MODEL:-}"
harness="${DSH_AGENT_HARNESS:-DeepSeek Harness}"

args=()
while (($# > 0)); do
  case "$1" in
    --model) model="${2:?agent-commit: --model needs a value}"; shift 2 ;;
    --model=*) model="${1#*=}"; shift ;;
    --harness) harness="${2:?agent-commit: --harness needs a value}"; shift 2 ;;
    --harness=*) harness="${1#*=}"; shift ;;
    --) shift; args+=("$@"); break ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ -z "${model//[[:space:]]/}" ]]; then
  cat >&2 <<'EOF'
agent-commit: name the model that actually ran, with --model "<name>" or $DSH_AGENT_MODEL.
  There is no default: the old one (DeepSeek V4 Flash) is retired, and a trailer naming a
  model that no longer exists is a false claim, not a missing one.
EOF
  exit 2
fi

[[ -n "${harness//[[:space:]]/}" ]] || { echo "agent-commit: --harness must not be blank" >&2; exit 2; }

slug="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
[[ -n "$slug" ]] || { echo "agent-commit: cannot derive an identity slug from '$model'" >&2; exit 2; }

export GIT_AUTHOR_NAME="$model"
export GIT_AUTHOR_EMAIL="${slug}@geokkjer.eu"
# GIT_COMMITTER_* is intentionally not set: the committer stays the human.
# Exporting the trailer (rather than letting the hook re-derive it) is what keeps the
# disclosure and the author identity from drifting apart.
export DSH_AGENT_TRAILER="Assisted-by: ${model} · ${harness}"

printf 'agent-commit: author = %s <%s>; trailer = %s\n' "$GIT_AUTHOR_NAME" "$GIT_AUTHOR_EMAIL" "$DSH_AGENT_TRAILER" >&2

exec git commit ${args[@]+"${args[@]}"}
