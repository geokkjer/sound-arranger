#!/usr/bin/env bash
# Attribute model commits automatically (paired with scripts/agent-commit).
#
# `scripts/agent-commit` exports `DSH_AGENT_TRAILER` for the model and harness it is
# committing as; this hook appends it verbatim whenever the message carries no
# `Assisted-by:` trailer yet. A commit made with the legacy hardcoded DeepSeek identity
# still gets the legacy trailer, so older workflows keep working. Everything else is left
# exactly as written: the hook discloses, it does not police.
#
# The hook receives the message file as $1; editing that file is the supported way to
# amend the message before the commit object is created.
set -euo pipefail

msg_file="${1:?commit-msg hook needs the message file path}"
author="${GIT_AUTHOR_NAME:-}"
author_email="${GIT_AUTHOR_EMAIL:-}"

trailer="${DSH_AGENT_TRAILER:-}"
if [[ -z "$trailer" ]]; then
  case "$author" in
    "DeepSeek V4 Flash") trailer='Assisted-by: DeepSeek-v4-flash · DeepSeek Harness' ;;
    *)
      # A model identity set by hand, with no generated disclosure. Say so rather than
      # let it pass silently — an unattributed model commit is what this convention
      # exists to prevent — but do not block: a deliberate hand-authored commit under a
      # model name is the human's call.
      if [[ "$author_email" == *"@geokkjer.eu" && "${author_email%%@*}" != "geir" ]]; then
        printf 'commit-msg: %s <%s> looks like a model identity with no Assisted-by trailer; use scripts/agent-commit (--model/--harness) so the disclosure is generated rather than remembered.\n' "$author" "$author_email" >&2
      fi
      exit 0
      ;;
  esac
fi

# Already attributed? Leave it alone (idempotent across --amend and re-runs).
if grep -qE '^Assisted-by:' "$msg_file"; then
  exit 0
fi

# Trim trailing blank lines, then append exactly one blank line + the trailer, so the
# message always ends in a clean trailer block.
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
awk 'NF { last = NR } { line[NR] = $0 } END { for (i = 1; i <= last; i++) print line[i] }' "$msg_file" > "$tmp"
printf '\n%s\n' "$trailer" >> "$tmp"
mv "$tmp" "$msg_file"
